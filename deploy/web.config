<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS 站台設定（放在 IIS 站台根目錄，站台目錄不需要放任何程式檔）
  需求：IIS URL Rewrite + Application Request Routing（啟用 Proxy）
  前端已打包進後端（server/public），所有請求都轉給 PM2 跑的 Node（localhost:3000）
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="selcos-proxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://localhost:3000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
