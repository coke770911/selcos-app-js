# ============================================================
# 選課系統環境參數
# 複製成 server/.env 後填入，不進版控
#
# 正式與測試參數放在同一個檔案（同舊系統 env.php）：
#   NODE_ENV=production  → 讀 DB_*、ADMIN_ACCOUNTS
#   NODE_ENV=development → 讀 TEST_DB_*、TEST_ADMIN_ACCOUNTS
# 測試模式不會退回使用正式參數；TEST_DB_HOST 填成正式機 172.16.29.1 會拒絕啟動
# ============================================================

# 模式：development（測試）／ production（正式）
NODE_ENV=development

PORT=3000

# ---------- 正式參數 ----------
DB_HOST=172.16.29.1
DB_PORT=1433
DB_NAME=OIT
DB_USER=
DB_PASS=
DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=true
# 可代登的管理員帳號（逗號分隔，不分大小寫）
ADMIN_ACCOUNTS=ot088,fz083,ot017

# ---------- 測試參數 ----------
TEST_DB_HOST=
TEST_DB_PORT=1433
TEST_DB_NAME=OIT
TEST_DB_USER=
TEST_DB_PASS=
TEST_DB_ENCRYPT=true
TEST_DB_TRUST_SERVER_CERT=true
TEST_ADMIN_ACCOUNTS=ot088,fz083,ot017,sharon,fa222,ex015,fa205,ching7720,fx023

# ---------- 共用參數 ----------
# AD 驗證
LDAP_URL=ldap://120.96.33.15
LDAP_DOMAIN=acc.ad

# 至少 32 字元的隨機字串；負載平衡的每台伺服器必須相同
#   產生：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# 快取（登入狀態、驗證碼）
#   sqlserver：存在 [CACHE].[dbo].[tb_Session]，負載平衡下多台伺服器共用（預設）
#   memory：只存在本機程序，限單一伺服器、單一程序
CACHE_DRIVER=sqlserver

# ---------- 依模式自動決定，需要時才填 ----------
# 標題後綴　　　　正式：空白　　　測試：[測試]
# APP_TITLE_SUFFIX=
# 選課可用時間（秒）正式：1800　測試：18000
# SESSION_TTL_SECONDS=
# 記錄層級　　　　正式：info　　　測試：debug
# LOG_LEVEL=
